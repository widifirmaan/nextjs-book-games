{
    "name": "nextjs-book-games",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:worker": "CLOUDFLARE_WORKER=1 npx -y @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion",
        "deploy": "CLOUDFLARE_WORKER=1 npx -y @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion && wrangler deploy",
        "db:setup": "node scripts/setup-local-db.mjs",
        "db:reset": "node scripts/setup-local-db.mjs --reset",
        "db:seed": "npx wrangler d1 execute school-games-db --local --file=schema.sql",
        "start": "next start",
        "lint": "next lint"
    },
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "bcryptjs": "^2.4.3",
        "next": "^14.2.35",
        "next-auth": "^4.24.5",
        "react": "^18",
        "react-dom": "^18",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "autoprefixer": "^10.0.1",
        "eslint": "^8",
        "eslint-config-next": "14.1.0",
        "postcss": "^8",
        "tailwindcss": "^3.3.0",
        "typescript": "^5"
    }
}
