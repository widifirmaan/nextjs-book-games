{
  "name": "nextjs-book-games",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-games-db",
      "database_id": "c8a25700-f366-4411-865c-48d24cb59603"
    }
  ],
  "routes": [
    {
      "pattern": "book-games.widifirmaan.web.id",
      "zone_name": "widifirmaan.web.id",
      "custom_domain": true
    }
  ]
}
